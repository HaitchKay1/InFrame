uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 crop_offset;
uniform float crop_scale;
sampler_state linearSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};
struct VertData { float4 pos : POSITION; float2 uv : TEXCOORD0; };
VertData VSDefault(VertData v) {
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}
float4 PSCrop(VertData v) : TARGET {
    return image.Sample(linearSampler, crop_offset + v.uv * crop_scale);
}
technique Draw {
    pass { vertex_shader = VSDefault(v); pixel_shader = PSCrop(v); }
}
